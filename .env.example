# Nexus Environment Configuration
# This is the safe source/development template.
# GitHub release binaries default to production mode with dry-run disabled
# unless environment variables override those build-time defaults.
# Copy this file to .env and fill in your values.
# cp .env.example .env
#
# NEVER commit .env to version control.
# All variables are prefixed with NEXUS_.

# =============================================================================
# Application
# =============================================================================

# Environment: development | production
NEXUS_APP_ENVIRONMENT=development

# DRY RUN GATE — mandatory. Set to false to enable memory writes.
# Default: true (safe default — no writes until explicitly enabled)
NEXUS_APP_DRY_RUN=true

# =============================================================================
# Storage
# =============================================================================

# Directory for Nexus data files (database, logs, etc.)
# Default: $HOME/.nexus
NEXUS_STORAGE_DATA_DIR=${HOME}/.nexus

# Full path to SQLite database file.
# Default: $NEXUS_STORAGE_DATA_DIR/nexus.db
# NEXUS_STORAGE_DB_PATH=${HOME}/.nexus/nexus.db

# =============================================================================
# Ollama (local embeddings)
# =============================================================================

# Ollama API base URL. Must be running before any embedding operations.
# Start with: ollama serve
NEXUS_OLLAMA_BASE_URL=http://localhost:11434

# Embedding model. Pull with: ollama pull nomic-embed-text
NEXUS_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# Inference Provider (for session memory extraction)
# =============================================================================

# Provider: ollama | lmstudio | anthropic | openai | gemini
# ollama/lmstudio = local, no API key needed
NEXUS_INFERENCE_PROVIDER=ollama

# Model — defaults are set per provider if omitted:
#   ollama    -> llama3.2
#   lmstudio  -> local-model
#   anthropic -> claude-haiku-4-5-20251001
#   openai    -> gpt-4o-mini
#   gemini    -> gemini-1.5-flash
NEXUS_INFERENCE_MODEL=llama3.2

# API key. Required for anthropic/openai/gemini when NEXUS_APP_DRY_RUN=false.
NEXUS_INFERENCE_API_KEY=

# Base URL. Only needed for ollama, lmstudio, or self-hosted endpoints.
# NEXUS_INFERENCE_BASE_URL=http://localhost:11434

# =============================================================================
# MCP Server
# =============================================================================

# Transport: stdio (Claude Code/Codex-style clients) | sse (HTTP/SSE clients)
# Default: stdio
NEXUS_MCP_TRANSPORT=stdio

# SSE server listen address (when NEXUS_MCP_TRANSPORT=sse)
# Default: 127.0.0.1:7798
# NEXUS_MCP_SSE_ADDR=127.0.0.1:7798

# =============================================================================
# Logging
# =============================================================================

# Log level: debug | info | warn | error
NEXUS_LOG_LEVEL=info

# Log format: console (development) | json (production)
# Auto-set based on NEXUS_APP_ENVIRONMENT if not specified.
# NEXUS_LOG_FORMAT=console

# Keep stdout reserved for MCP JSON-RPC and command output.
NEXUS_LOG_OUTPUT_PATH=stderr
